# Server
HOST=0.0.0.0
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# MongoDB (same cluster/db as the main Node backend, separate collections)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_interviewer

# Frame processing
FRAME_PROCESS_EVERY_N=2          # process every Nth frame for perf (client can also throttle FPS)
MAX_FRAME_WIDTH=640              # frames are resized to this width before processing

# Object detection (optional, requires ultralytics + downloaded weights)
ENABLE_OBJECT_DETECTION=false
YOLO_MODEL_PATH=yolov8n.pt
OBJECT_DETECTION_EVERY_N=15      # run YOLO much less often than face mesh (expensive)

# Report output
REPORTS_DIR=./reports
LOGS_DIR=./logs
